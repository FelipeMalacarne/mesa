Project shop {
}

Enum billing.currency {
  USD
  EUR
  "BRL "
}

Enum order_status {
  pending
  shipped
  "on hold"
}

Table billing.accounts {
  id uuid [pk, default: `gen_random_uuid()`]
  "owner id" int8 [not null, ref: > users.id]
  currency billing.currency [not null, default: 'USD']
  balance numeric(12,2) [not null, default: 0]
  tags text[] [default: `'{}'::text[]`]
  active boolean [default: true]
  closed_at "timestamp with time zone"
  score float8 [default: -1.5]
  parent_id uuid [ref: > billing.accounts.id]

  Note: 'Accounts of the billing schema'
}

Table order_items {
  order_id int8 [not null]
  line int4 [not null]
  sku text [not null]
  qty int4 [not null, default: 1]

  indexes {
    (order_id, line) [pk, name: 'order_items_pk']
  }
}

Table orders {
  id int8 [pk]
  user_id int8 [not null, ref: > users.id]
  account_id uuid [not null]
  status order_status [not null, default: 'pending']
  placed_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, status) [unique, name: 'orders_account_status_key']
    (user_id, status) [unique]
    (status, placed_at)
  }
}

Table skus {
  order_id int8
  sku text

  indexes {
    (order_id, sku) [pk]
  }
}

Table users {
  id int8 [pk, increment, note: 'Surrogate key']
  email varchar(255) [unique, not null, default: '']
  nick text [unique]
  motto text [default: 'it\'s fine']
  bio text [note: '''
    Free text.
      Indented line.

    Last line.
  ''']

  indexes {
    `lower(email)` [unique, name: 'users_email_lower_idx', type: btree]
    `now()`
    `now()` [name: 'users_expr_idx1']
    (id, `lower(nick)`)
    nick [type: hash]
  }
}

Ref: order_items.order_id > orders.id [delete: cascade, update: cascade]
Ref order_items_skus_fkey: order_items.(order_id, sku) > skus.(order_id, sku) [delete: set null]
Ref billing_account: orders.account_id > billing.accounts.id [delete: restrict, update: cascade]
